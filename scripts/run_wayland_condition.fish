#!/usr/bin/env fish
# Run one reproducible Phase 4 condition. Real pointer/keyboard input remains
# human-generated by the benchmark window; this script controls only workload,
# scheduler mode, output naming, and cleanup of its own background PIDs.

if test (count $argv) -ne 4
    echo "usage: run_wayland_condition.fish LABEL normal|ttl|closed|ab|dep-off|dep-on WORKERS TRIALS" >&2
    exit 2
end

set label $argv[1]
set mode $argv[2]
set workers $argv[3]
set trials $argv[4]
if not string match -qr '^[0-9]+$' -- $workers; or not string match -qr '^[1-9][0-9]*$' -- $trials
    echo "workers must be >= 0 and trials must be positive" >&2
    exit 2
end
if test "$mode" != normal; and test "$mode" != ttl; and test "$mode" != closed; and test "$mode" != ab; and test "$mode" != dep-off; and test "$mode" != dep-on
    echo "mode must be normal, ttl, closed, ab, dep-off, or dep-on" >&2
    exit 2
end

set root (realpath (dirname (status filename))/..)
set bench "$root/benchmarks/wayland_interaction/build/pulsesched-wayland-bench"
set raw "$root/results/raw"
mkdir -p $raw
if not test -x $bench
    echo "benchmark not built: $bench" >&2
    exit 3
end
if test -z "$WAYLAND_DISPLAY"; or test -z "$XDG_RUNTIME_DIR"
    echo "WAYLAND_DISPLAY and XDG_RUNTIME_DIR must be set" >&2
    exit 3
end

set bg_pids
function cleanup --on-event fish_exit
    for pid in $bg_pids
        if kill -0 $pid 2>/dev/null
            kill $pid 2>/dev/null
        end
    end
    for pid in $bg_pids
        wait $pid 2>/dev/null
    end
end

for i in (seq 1 $workers)
    yes > /dev/null &
    set bg_pids $bg_pids $last_pid
end

set run_id (date +%Y%m%d-%H%M%S)
set output "$raw/$label-$run_id.jsonl"
if test "$mode" = ttl; or test "$mode" = closed; or test "$mode" = ab; or test "$mode" = dep-off; or test "$mode" = dep-on
    set policy_mode ttl
    if test "$mode" = closed
        set policy_mode closed
    else if test "$mode" = ab
        set policy_mode ab
    else if test "$mode" = dep-off
        set policy_mode dep-off
    else if test "$mode" = dep-on
        set policy_mode dep-on
    end
    sudo env WAYLAND_DISPLAY=$WAYLAND_DISPLAY XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR \
        $bench 20 $trials 1000 100 $policy_mode | tee $output
else
    $bench 20 $trials 1000 0 | tee $output
end
set rc $pipestatus[1]
echo "raw_output=$output" >&2
exit $rc
